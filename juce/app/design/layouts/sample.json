  "tabs": [
    {"title": "Sample", "groups": [
      {"title": "Trim", "parameters": [
        {"name": "sample start position", "label": "Start", "role": "sample", "control": "slider"},
        {"name": "sample end position", "label": "End", "role": "sample", "control": "slider"}]},
      {"title": "Loop", "parameters": [
        {"name": "sample loop start", "label": "Loop start", "role": "sample", "control": "slider"},
        {"name": "sample loop end", "label": "Loop end", "role": "sample", "control": "slider"},
        {"name": "sample playback mode", "label": "Mode", "role": "sample", "control": "choice"}]},
      {"title": "Pitch", "parameters": [
        {"name": "sample original pitch", "label": "Root", "role": "general", "control": "valuebox"},
        {"name": "sample semitone tune", "label": "Semi", "role": "general", "control": "knob"},
        {"name": "sample fine tune", "label": "Fine", "role": "general", "control": "knob"}]}]}
  ]
}
