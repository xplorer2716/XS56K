{
  "_comment": "The design system's single source of truth: global tokens hold values, semantic tokens alias global ones, component tokens alias semantic (or global size) ones. Edited by hand, read by juce/tools/generate_design.py and juce/tools/generate_mockups.py. [RQ-APP-001, RQ-APP-002, RQ-APP-005, ADR-APP-002 (DEC-APP-011), process/1.requirements/DESIGN-SYSTEM-APP.md]",
  "theme": "dark",
  "global": {
    "colour.grey.950": "#1B1C1F",
    "colour.grey.900": "#202125",
    "colour.grey.850": "#2A2B30",
    "colour.grey.800": "#35363C",
    "colour.grey.700": "#45464D",
    "colour.grey.500": "#6C6D75",
    "colour.grey.300": "#A9AAB2",
    "colour.grey.100": "#ECECEF",
    "colour.violet.300": "#A897F2",
    "colour.teal.300": "#4FD1C1",
    "colour.amber.300": "#E9A85A",
    "colour.yellow.300": "#F2C94C",
    "colour.red.300": "#F47A74",
    "colour.green.300": "#6CCB7A",

    "font.family.ui": "Inter",
    "font.weight.regular": 400,
    "font.weight.medium": 500,
    "size.text.13": 13,
    "size.text.15": 15,
    "size.text.17": 17,
    "size.text.20": 20,
    "size.tracking.label": 0.5,

    "size.space.1": 4,
    "size.space.2": 8,
    "size.space.3": 12,
    "size.space.4": 16,
    "size.space.6": 24,
    "size.space.8": 32,

    "size.radius.sharp": 0,
    "size.radius.soft": 3,
    "size.radius.round": 6,
    "size.stroke.hairline": 1,
    "size.stroke.focus": 2,
    "size.stroke.arc": 3,

    "size.control.small": 20,
    "size.control.medium": 24,
    "size.control.large": 28,
    "size.knob.large": 40,
    "size.icon.small": 12,
    "size.icon.default": 16,

    "size.window.minWidth": 1024,
    "size.window.minHeight": 680,
    "size.left.minWidth": 240,
    "size.area.minHeight": 160,
    "size.edit.minWidth": 640,

    "motion.hover": 80,
    "motion.busy": 1000,
    "motion.message": 4000,
    "motion.tooltip": 700,

    "opacity.scrim.default": 0.6
  },
  "semantic": {
    "colour.surface.base": {"alias": "colour.grey.950", "use": "window background, between panels"},
    "colour.surface.panel": {"alias": "colour.grey.850", "use": "panels (browser, memory view, edit panel groups)"},
    "colour.surface.recessed": {"alias": "colour.grey.900", "use": "inputs, lists, value boxes, graph backgrounds"},
    "colour.surface.raised": {"alias": "colour.grey.800", "use": "hovered rows, buttons, dialogs"},
    "colour.border.default": {"alias": "colour.grey.700", "use": "panel and control outlines, separators"},
    "colour.text.primary": {"alias": "colour.grey.100", "use": "values, names"},
    "colour.text.secondary": {"alias": "colour.grey.300", "use": "labels (upper case), captions"},
    "colour.text.disabled": {"alias": "colour.grey.500", "use": "disabled controls and their labels"},
    "colour.accent.default": {"alias": "colour.violet.300", "use": "selection, focus, current tab"},
    "colour.role.sample": {"alias": "colour.violet.300", "use": "samples, zones, sample assignment"},
    "colour.role.modulation": {"alias": "colour.teal.300", "use": "envelopes, LFOs, modulation sources"},
    "colour.role.filter": {"alias": "colour.amber.300", "use": "filter (its envelope is an envelope: modulation)"},
    "colour.role.general": {"alias": "colour.grey.300", "use": "parameters of no colour-coded family (output, MIDI/tune, pitch bend)"},
    "colour.status.active": {"alias": "colour.yellow.300", "use": "on, current item of a list, a switch that is on"},
    "colour.status.success": {"alias": "colour.green.300", "use": "connected"},
    "colour.status.error": {"alias": "colour.red.300", "use": "failed, refused, lost connection"},
    "colour.status.destructive": {"alias": "colour.red.300", "use": "the confirm button of a destructive action"},
    "colour.status.pending": {"alias": "colour.grey.300", "use": "value sent and not yet read back"},

    "font.caption.size": {"alias": "size.text.13", "use": "captions, units, status details"},
    "font.label.size": {"alias": "size.text.13", "use": "parameter and group labels, upper case"},
    "font.label.tracking": {"alias": "size.tracking.label", "use": "letter spacing of labels"},
    "font.value.size": {"alias": "size.text.15", "use": "values, names in lists and trees"},
    "font.title.size": {"alias": "size.text.17", "use": "panel titles, the edited item's name"},
    "font.heading.size": {"alias": "size.text.20", "use": "dialog titles"},

    "space.inside": {"alias": "size.space.2", "use": "padding inside a control or a panel"},
    "space.between": {"alias": "size.space.2", "use": "between controls of a group"},
    "space.group": {"alias": "size.space.4", "use": "between groups"},
    "space.edge": {"alias": "size.space.2", "use": "window edge, between areas"},

    "radius.panel": {"alias": "size.radius.round", "use": "panels"},
    "radius.control": {"alias": "size.radius.soft", "use": "controls, value boxes, buttons"},
    "stroke.hairline": {"alias": "size.stroke.hairline", "use": "outlines, separators"},
    "stroke.focus": {"alias": "size.stroke.focus", "use": "focus outline, icons"},
    "stroke.arc": {"alias": "size.stroke.arc", "use": "knob arcs"},
    "opacity.scrim": {"alias": "opacity.scrim.default", "use": "the veil over the window behind a dialog"}
  },
  "component": {
    "knob.arc.track": "colour.border.default",
    "knob.pointer": "colour.text.primary",
    "knob.size.default": "size.knob.large",
    "knob.size.small": "size.control.large",
    "valuebox.surface": "colour.surface.recessed",
    "valuebox.text": "colour.text.primary",
    "valuebox.unit": "colour.text.secondary",
    "valuebox.height": "size.control.small",
    "choice.surface": "colour.surface.recessed",
    "choice.arrow": "colour.text.secondary",
    "choice.text": "colour.text.primary",
    "switch.dot.on": "colour.status.active",
    "switch.dot.off": "colour.border.default",
    "tab.text": "colour.text.secondary",
    "tab.text.selected": "colour.text.primary",
    "tab.underline.selected": "colour.accent.default",
    "tab.height": "size.control.large",
    "row.height": "size.control.medium",
    "row.surface.hover": "colour.surface.raised",
    "row.bar.selected": "colour.accent.default",
    "row.dot.current": "colour.status.active",
    "header.title": "colour.text.primary",
    "header.kind": "colour.text.secondary",
    "button.surface": "colour.surface.raised",
    "button.text": "colour.text.primary",
    "button.destructive.surface": "colour.status.destructive",
    "button.destructive.text": "colour.surface.base",
    "status.dot.connected": "colour.status.success",
    "status.dot.failed": "colour.status.error",
    "status.spinner": "colour.text.secondary",
    "status.height": "size.control.large",
    "status.dot.size": "size.icon.small",
    "status.spinner.size": "size.icon.default",
    "dialog.surface": "colour.surface.raised",
    "dialog.border": "colour.border.default",
    "dialog.scrim": "colour.surface.base",
    "dialog.width": "size.edit.minWidth",
    "button.height": "size.control.large"
  },
  "contrast": {
    "minimum": 4.5,
    "text": ["colour.text.primary", "colour.text.secondary", "colour.role.sample", "colour.role.modulation", "colour.role.filter",
             "colour.status.active", "colour.status.error", "colour.status.success"],
    "on": ["colour.surface.base", "colour.surface.panel", "colour.surface.recessed", "colour.surface.raised"],
    "pairs": [["button.destructive.text", "button.destructive.surface"]]
  }
}
